<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      The shell the system draws before Compose has its first frame.

      Light, because the application is light by default. It used to be #121212 here and in both
      system bars, which meant the launch flash and the status and navigation bars stayed dark
      whatever the user had chosen — the preference could not reach them, since these are resources
      and it is a runtime value. The bars are now handled in MainActivity, which *can* read the
      choice; this only has to match the ordinary case so the first frame does not flash.
    -->
    <style name="Theme.PixelLab" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">#FFF4F5F7</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
